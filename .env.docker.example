# Ripperr's Tailscale Serve HTTPS URL, reachable from the Mac Pro.
RIPPERR_SERVER=https://rickys-mac-pro.taile4827e.ts.net
RIPPERR_API_TOKEN=replace-with-a-worker-token

# Accept the pyannote model conditions and create a Hugging Face read token.
RIPPERR_HF_TOKEN=replace-with-a-hugging-face-token

RIPPERR_WORKER_NAME=ripperr-mac-pro
RIPPERR_ASR_BACKEND=whistle
RIPPERR_ASR_MODEL=Cactus-Compute/whistle
RIPPERR_ASR_KEYWORDS=
RIPPERR_DIARIZATION_BACKEND=pyannote
RIPPERR_DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
RIPPERR_DEVICE=cpu
# Leave empty to detect the language per episode.
RIPPERR_LANGUAGE=
